    "eslint-plugin-format": "^1.0.1",
    "jest": "^29.7.0",
    "node-gyp": "^11.1.0",
    "nodemon": "^3.1.9",
    "shx": "^0.3.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typedoc": "^0.27.9",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
