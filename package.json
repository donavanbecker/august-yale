  "scripts": {
    "check": "npm install && npm outdated",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "watch": "npm run build && npm link && nodemon",
    "build": "npm run clean && tsc",
    "prepublishOnly": "npm run lint && npm run build && npm run docs && npm run docs:lint && npm run docs:theme",
    "postpublish": "npm run clean && npm ci",
    "clean": "shx rm -rf ./dist",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test-coverage": "npm run test -- --coverage",
    "docs": "typedoc",
    "docs:lint": "typedoc --emit none --treatWarningsAsErrors",
    "docs:theme": "typedoc --theme default-modern"
  },
  "dependencies": {
    "pubnub": "^8.9.1",
    "tiny-json-http": "^7.5.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.4.0",
